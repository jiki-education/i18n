# Generated publish artifacts. Rebuilt from locales/ by `pnpm publish:build`,
# never committed: they are content-hashed derivatives, and committing them
# would double every translation diff.
dist/

# Provider API keys for scripts/translate.mjs.
.env
.env.*
!.env.example

# Scratch output from a failed translate run.
tmp/

node_modules/
.DS_Store

# The front-end checkout English is read from. Ephemeral and rebuildable:
# `npm run source:checkout`, or the checkout step in CI. English is never
# stored in this repo. See ENGLISH-SOURCE.md.
.source/
