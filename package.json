{
  "name": "@jiki/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Jiki's translated output, and the scripts that produce and publish it.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@jiki.io/content-renderer": "0.4.0"
  },
  "scripts": {
    "source:checkout": "node scripts/source-checkout.mjs",
    "stub": "node scripts/stub.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:shippable": "node scripts/validate.mjs all --shippable --no-stamp",
    "coverage": "node scripts/coverage.mjs",
    "have-translations": "node scripts/have-translations.mjs",
    "verify-renderer": "node scripts/verify-renderer.mjs",
    "publish:build": "node scripts/publish.mjs",
    "publish:upload": "node scripts/publish.mjs all --upload",
    "test": "node scripts/test.mjs",
    "check": "node scripts/test.mjs && node scripts/validate.mjs all --no-stamp"
  }
}
